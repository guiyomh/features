{
    "name": "just",
    "id": "just",
    "version": "0.1.0",
    "description": "Installs just, just is a handy way to save and run project-specific commands on justfile.",
    "documentationURL": "https://github.com/guiyomh/features/tree/main/src/just",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest",
                "1"
            ],
            "default": "latest",
            "description": "Select version of just."
        },
        "lspVersion": {
            "type": "string",
            "proposals": [
                "false",
                "latest",
                "0.4.2"
            ],
            "default": "false",
            "description": "Install just-lsp, a language server for just. Set to 'false' to skip, 'latest' for the newest release, or a specific version number."
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
